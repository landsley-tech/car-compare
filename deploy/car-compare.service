[Unit]
Description=Car Compare
After=network-online.target

[Service]
ExecStart=/usr/bin/python3 /opt/car-compare/server.py
# home network + Tailscale only; for public use switch to HOST=127.0.0.1 TRUST_PROXY=cloudflare
Environment=HOST=0.0.0.0 PORT=8000
Restart=always
RestartSec=2
# sandboxing: no root, read-only system, nothing else visible
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
MemoryMax=256M
TasksMax=200

[Install]
WantedBy=multi-user.target
